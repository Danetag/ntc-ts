{
  "name": "ntc-ts",
  "version": "0.2.0",
  "description": "\"Name That Color\" as a typescript library!",
  "author": "Arnaud Tanielian <arno.tanielian@gmail.com> (https://cargocollective.com/danetag)",
  "keywords": [
    "ntc",
    "color",
    "name that color"
  ],
  "license": "CC-BY-4.0",
  "homepage": "https://github.com/Danetag/ntc-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Danetag/ntc-ts.git"
  },
  "bugs": {
    "url": "https://github.com/Danetag/ntc-ts/issues",
    "email": "arno.tanielian@gmail.com"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/ntc-ts.cjs",
  "module": "./dist/ntc-ts.module.js",
  "types": "./dist/ntc-ts.d.ts",
  "unpkg": "./dist/ntc-ts.umd.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/ntc-ts.d.ts",
        "default": "./dist/ntc-ts.module.js"
      },
      "require": {
        "types": "./dist/ntc-ts.d.cts",
        "default": "./dist/ntc-ts.cjs"
      },
      "default": "./dist/ntc-ts.module.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/postbuild.mjs",
    "check:package": "node scripts/verify-package.mjs",
    "check:runtime": "node scripts/verify-runtime-package.mjs",
    "coverage": "vitest run --coverage",
    "dev": "rollup --config --watch",
    "lint": "eslint .",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.0.1",
    "rollup": "^4.63.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
